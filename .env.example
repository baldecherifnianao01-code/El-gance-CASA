# Configuration ÉLÉGANCE CASA
# Identifiants Administrateur (définir dans les Secrets de l'environnement de production)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# Clé secrète de signature des jetons de session (optionnel en développement, recommandé en production)
SESSION_SECRET=""

# Passerelle de paiement marocaine (CMI / Payzone / Naps) - laisser vide tant qu'aucune passerelle n'est connectée
PAYMENT_GATEWAY_URL=""
PAYMENT_GATEWAY_MERCHANT_ID=""
PAYMENT_GATEWAY_SECRET_KEY=""

# URL publique de l'application
APP_URL="MY_APP_URL"

# Clé API Gemini (optionnelle, injectée automatiquement par l'environnement si utilisée)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
